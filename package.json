{
  "name": "sahay-firebase",
  "private": true,
  "type": "module",
  "description": "Sahay, browser-only edition for Firebase Hosting + Firestore + Firebase AI Logic",
  "scripts": {
    "export": "cd .. && python scripts/export_web_data.py",
    "bundle": "esbuild src/firebase-sdk.js --bundle --format=esm --minify --outfile=public/vendor/firebase-sdk.js",
    "test": "node --test test/*.test.mjs",
    "serve": "npx --yes http-server public -p 5000 -c-1",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "firebase": "12.19.0",
    "@techstark/opencv-js": "4.11.0-release.1"
  }
}
